---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import OrbitMark from "../components/OrbitMark.astro";
import meta from "../data/generated/meta.json";
import { blob, npm, repo, url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "orrery: architecture diagrams with official cloud icons",
  description = `Write a YAML spec; orrery lays it out with ELK and renders animated SVG, PNG, draw.io, React TSX and HTML with ${meta.icons.toLocaleString("en-US")} official AWS, Azure, Google Cloud, Kubernetes, GitHub and IBM icons.`,
  image = "art/hero-dark.svg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ["Gallery", url("gallery/")],
  ["Install", url("#install")],
  ["Icons", url("#icons")],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#0b1012" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-canvas"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-line bg-canvas">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-5 sm:px-8">
        <a href={url()} class="mr-auto inline-flex min-h-11 items-center gap-2.5 font-semibold tracking-tight">
          <OrbitMark />
          <span class="text-[1.05rem]">orrery</span>
          <span class="chip hidden sm:inline-flex">v{meta.version}</span>
        </a>
        {
          nav.map(([label, href]) => (
            <a
              href={href}
              class="hidden min-h-11 items-center rounded-lg px-3 text-sm text-dim transition-colors duration-200 hover:text-ink sm:inline-flex"
            >
              {label}
            </a>
          ))
        }
        <a href={url("gallery/")} class="inline-flex min-h-11 items-center px-3 text-sm text-dim hover:text-ink sm:hidden">
          Gallery
        </a>
        <a href={repo} class="btn btn-ghost !min-h-10 !px-4 text-sm" aria-label="orrery on GitHub">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-[1.4fr_1fr_1fr] sm:px-8">
        <div class="space-y-4">
          <a href={url()} class="inline-flex items-center gap-2.5 font-semibold"><OrbitMark /> orrery</a>
          <p class="max-w-sm text-sm text-dim">
            Architecture and system design diagrams from a YAML spec, with official icons, automatic layout and five
            output formats. MIT licensed.
          </p>
          <p class="max-w-sm text-xs text-faint">
            Icons, logos and trademarks belong to their owners and are used under the terms in{" "}
            <a class="underline decoration-line-strong underline-offset-4 hover:text-ink" href={blob("THIRD_PARTY_NOTICES.md")}
              >THIRD_PARTY_NOTICES.md</a
            >.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4">Project</p>
          <ul class="space-y-2.5 text-sm text-dim">
            <li><a class="hover:text-ink" href={url("gallery/")}>Gallery</a></li>
            <li><a class="hover:text-ink" href={blob("skills/orrery/references/spec.md")}>Spec reference</a></li>
            <li><a class="hover:text-ink" href={blob("CHANGELOG.md")}>Changelog</a></li>
            <li><a class="hover:text-ink" href={blob("SECURITY.md")}>Security</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Elsewhere</p>
          <ul class="space-y-2.5 text-sm text-dim">
            <li><a class="hover:text-ink" href={repo}>GitHub</a></li>
            <li><a class="hover:text-ink" href={npm}>npm</a></li>
            <li><a class="hover:text-ink" href={`${repo}/releases`}>Releases</a></li>
            <li><a class="hover:text-ink" href="https://github.com/Sagargupta16">Built by Sagar Gupta</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line">
        <p class="mx-auto max-w-6xl px-5 py-6 font-mono text-xs text-faint sm:px-8">
          orrery {meta.version} &middot; MIT &copy; {new Date().getFullYear()} Sagar Gupta
        </p>
      </div>
    </footer>
  </body>
</html>
