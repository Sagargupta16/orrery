---
// The logo: a sun and two planets on their orbits. The planets turn; the mark is never static.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="13.5" stroke="rgb(255 255 255 / 0.22)" />
  <circle cx="16" cy="16" r="8" stroke="rgb(255 255 255 / 0.32)" />
  <circle cx="16" cy="16" r="3.2" fill="#e6edf3" />
  <g class="orbit" style="--period: 9s">
    <circle cx="24" cy="16" r="2" fill="#60a5fa" />
  </g>
  <g class="orbit orbit-reverse" style="--period: 16s">
    <circle cx="16" cy="2.5" r="1.6" fill="#e6edf3" />
  </g>
</svg>
