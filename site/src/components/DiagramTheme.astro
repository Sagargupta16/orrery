---
// Switches every diagram on the page between its skins (stage, classic) and themes (dark, light).
// Each choice is remembered; stage and dark, the defaults, come first.
---

<div class="flex flex-wrap items-center gap-2">
  <div class="inline-flex rounded-full border border-line p-1" role="group" aria-label="Diagram style">
    <button type="button" data-diagram-skin="stage" class="diagram-skin min-h-9 rounded-full px-3.5 font-mono text-xs"
      >Stage</button
    >
    <button type="button" data-diagram-skin="classic" class="diagram-skin min-h-9 rounded-full px-3.5 font-mono text-xs"
      >Classic</button
    >
  </div>
  <div class="inline-flex rounded-full border border-line p-1" role="group" aria-label="Diagram theme">
    <button type="button" data-diagram-theme="dark" class="diagram-theme min-h-9 rounded-full px-3.5 font-mono text-xs"
      >Dark</button
    >
    <button type="button" data-diagram-theme="light" class="diagram-theme min-h-9 rounded-full px-3.5 font-mono text-xs"
      >Light</button
    >
  </div>
</div>

<style is:global>
  .diagram-theme,
  .diagram-skin {
    color: var(--color-dim);
    transition:
      background-color 180ms var(--ease-out-quint),
      color 180ms var(--ease-out-quint);
  }
  html:not([data-diagrams="light"]) .diagram-theme[data-diagram-theme="dark"],
  html[data-diagrams="light"] .diagram-theme[data-diagram-theme="light"],
  html:not([data-skin="classic"]) .diagram-skin[data-diagram-skin="stage"],
  html[data-skin="classic"] .diagram-skin[data-diagram-skin="classic"] {
    background: var(--color-ink);
    color: var(--color-canvas);
  }
  /* One of the four renders shows: skin by theme. */
  .thumb {
    display: none;
  }
  html:not([data-skin="classic"]):not([data-diagrams="light"]) .thumb-stage-dark,
  html:not([data-skin="classic"])[data-diagrams="light"] .thumb-stage-light,
  html[data-skin="classic"]:not([data-diagrams="light"]) .thumb-classic-dark,
  html[data-skin="classic"][data-diagrams="light"] .thumb-classic-light {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;
  if (localStorage.getItem("orrery-diagrams") === "light") root.dataset.diagrams = "light";
  if (localStorage.getItem("orrery-skin") === "classic") root.dataset.skin = "classic";
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.diagram-theme")) {
    button.addEventListener("click", () => {
      const theme = button.dataset.diagramTheme ?? "dark";
      root.dataset.diagrams = theme;
      localStorage.setItem("orrery-diagrams", theme);
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.diagram-skin")) {
    button.addEventListener("click", () => {
      const skin = button.dataset.diagramSkin ?? "stage";
      root.dataset.skin = skin;
      localStorage.setItem("orrery-skin", skin);
    });
  }
</script>
