{
  "name": "orrery-site",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "The orrery website: every example rendered by the repo's own CLI, built with Astro and deployed to GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare-content": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && astro dev",
    "build": "node scripts/prepare.mjs && astro build",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1"
  }
}
